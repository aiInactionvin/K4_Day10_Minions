          ],
          "date-time": "2026-04-10T09:49:00Z",
          "timestamp": 1775814540528,
          "version": "3.50.1"
        },
        "reference-count": 0,
        "publisher": "EWA Publishing",
        "issue": "2",
        "content-domain": {
          "domain": [],
          "crossmark-restriction": false
